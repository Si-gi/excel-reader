{
    "name": "si-gi/excel-reader",
    "description": "Analyzing and extracting values from an Excel file",
    "type": "library",
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "2.1.x-dev",
        "mikey179/vfsstream": "^2.0@dev"
    },
    "license": "GPL-2.0-or-later",
    "keywords": [
        "excel",
        "reader",
        "fast",
        "fastest",
        "simple"
    ],
    "autoload": {
        "psr-4": {
            "Sigi\\ExcelReader\\": "src/"
        }
    },  
    "autoload-dev": {
        "psr-4": {
        "JsonRpc\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Simon Gilbert",
            "email": "gilbert.simonj@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.4",
        "blackfire/php-sdk": "^2.5@dev"
    }
}
